{
  // Hébergement Cloudflare Workers : le dossier app/ est publié, src/worker.js
  // porte la protection par mot de passe et le carnet de terrain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carte-rock-londres",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // Assemble app/data et app/vendor avant chaque déploiement.
  "build": { "command": "node scripts/construire.mjs" },
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Tout passe par le Worker (mot de passe), sauf les fichiers publics du fond de carte.
    "run_worker_first": ["/*", "!/tuiles/*", "!/polices/*", "!/pictos/*", "!/vendor/*", "!/outils/*"]
  },
  // Sans identifiant : l'espace KV est créé au premier déploiement.
  "kv_namespaces": [{ "binding": "CARNET" }],
  // Sans nom : l'espace photos est créé au premier déploiement (R2 activé le 13/11/2026).
  "r2_buckets": [{ "binding": "MEDIAS" }],
  "workers_dev": true,
  "preview_urls": false,
  // Garde les réglages faits dans le tableau de bord.
  "keep_vars": true
}
